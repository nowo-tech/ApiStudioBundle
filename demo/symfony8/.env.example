# Demo environment template. Copy to .env (e.g. cp .env.example .env) and adjust.
# Do not commit .env or local .env* files.
#
# Inside Docker, docker-compose.yml sets DATABASE_URL to MySQL on host `database` (REQ-DEMO-011).
# The value below is for reference / CLI outside compose.

# APP_ENV: Symfony environment (dev/test/prod). Demo uses `dev`.
APP_ENV=dev

# APP_SECRET: Secret for CSRF/session signing. Use a local-only value in development.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: Enable/disable detailed debug output (1 in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# PORT: Host port mapped to the FrankenPHP (Caddy) HTTP service (see docker-compose `php` service).
PORT=8023

# TRUSTED_PROXIES: Trusted proxies when behind Caddy/Traefik.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# DEFAULT_URI: Base URL for CLI URL generation; should match PORT above.
DEFAULT_URI=http://localhost:8023

# MYSQL_DATABASE: Database created by the demo MySQL container (docker-compose `database` service).
MYSQL_DATABASE=app

# MYSQL_USER: Application user created in the demo MySQL container.
MYSQL_USER=app

# MYSQL_PASSWORD: Password of MYSQL_USER (local-only demo value).
MYSQL_PASSWORD=app

# DATABASE_URL: Doctrine DSN. Inside Compose the service hostname is `database` (docker-compose overrides this value).
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=8.4&charset=utf8mb4"
