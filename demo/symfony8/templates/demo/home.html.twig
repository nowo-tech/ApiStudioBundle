{% extends 'base.html.twig' %}

{% block title %}API Studio Demo{% endblock %}

{% block body %}
<div>
    <h1>API Studio Bundle — Demo</h1>
    <p>Catálogo interno tipo Postman / Apidog para documentar y probar APIs REST, SOAP y GraphQL.</p>

    <div>
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_api_studio_dashboard') }}">Abrir API Studio</a>
    </div>

    <h2>APIs de referencia incluidas en el seed</h2>
    <div>
        <div class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h3>JSONPlaceholder <span class="nowo-ui-badge nowo-ui-badge--success">ejecutable</span></h3>
                    <p class="nowo-ui-muted">REST público sin credenciales. Ideal para probar el request console en vivo.</p>
                </div>
        </div>
        <div class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h3>LinkedIn API v2</h3>
                    <p class="nowo-ui-muted">Perfil, publicaciones UGC y búsqueda de organizaciones. OAuth Bearer + ejemplos 200/401.</p>
                </div>
        </div>
        <div class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h3>Google Cloud Translation</h3>
                    <p class="nowo-ui-muted">Traducir, detectar idioma y listar idiomas soportados. API key en entorno.</p>
                </div>
        </div>
        <div class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h3>Catastro (España) <span class="nowo-ui-badge nowo-ui-badge--info">SOAP</span></h3>
                    <p class="nowo-ui-muted">Sede Electrónica del Catastro: Consulta_CPMRC y Consulta_DNPRC con envelopes XML y respuestas de ejemplo.</p>
                </div>
        </div>
        <div class="nowo-ui-card">
                <div class="nowo-ui-card__body">
                    <h3>Catastro — consulta HTTP</h3>
                    <p class="nowo-ui-muted">Variantes GET documentadas por referencia catastral y coordenadas (administración pública).</p>
                </div>
        </div>
    </div>

    <hr>

    <p class="nowo-ui-muted">Primera vez en este entorno:</p>
    <pre><code class="nowo-ui-code">php bin/console nowo:api-studio:sync-schema
php bin/console nowo:api-studio:seed-demo
php bin/console nowo:api-studio:seed-demo --fresh
php bin/console assets:install</code></pre>
</div>
{% endblock %}
