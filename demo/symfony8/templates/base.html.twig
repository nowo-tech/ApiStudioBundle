{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform); every API Studio page renders through it too (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locales = [] %}
{% for locale in nowo_api_studio_locales %}
    {% set _locales = _locales|merge([{code: locale, label: ('locale.' ~ locale)|trans({}, 'NowoApiStudioBundle'), href: path('nowo_api_studio_locale_switch', {_locale: locale})}]) %}
{% endfor %}
{% set nowo_ui_demo_platform = {
    bundle: 'API Studio',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/ApiStudioBundle',
    translation_domain: 'demo',
    locales: _locales|length > 1 ? _locales : [],
    nav: [
        {label: 'nav.home', route: 'demo_home'},
        {label: 'nav.dashboard', route: 'nowo_api_studio_dashboard'},
        {label: 'nav.workspaces', route: 'nowo_api_studio_workspace_index', active: ['nowo_api_studio_workspace*']},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'title'|trans({}, 'demo') }}{% endblock %} — Symfony 8{% endblock %}
