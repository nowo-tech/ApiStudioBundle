{#
  Import (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from ApiStudioPageFactory::import():
  header = import title / import.help with breadcrumbs and a back link; ImportFileFormType (file, optional mode /
  importVariables) as multipart; submit import.submit; cancel = the service, the environment or the hub).
  Blocks filled: nowo_ui_styles, nowo_ui_form_body (the child loop without the form type's own submit button: the
  scaffold renders the submit).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_form_body %}
    {% if form.submit is defined %}{% do form.submit.setRendered %}{% endif %}
    {{ parent() }}
{% endblock %}
