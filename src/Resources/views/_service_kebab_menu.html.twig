{#
  Service actions menu: the UiKit kebab partial. Export downloads; Import and Delete open the remote dialog of
  _service_dialog_shell.html.twig, which loads their content when they open. Variables: service, workspace; optional delete_redirect (local path after the delete).
  Items the user may not use (nowo_api_studio_can) are left out.
#}
{% set delete_redirect = delete_redirect|default(api_studio_path('nowo_api_studio_workspace_show', {id: workspace.id})) %}
{% set _items = [] %}
{# Owner rule 2026-11-23 (every dialog loads its content on demand): Export is a direct download (one format, nothing to ask);
   Import and Delete open the remote dialog 'as-service-dialog', filled from the GET of their route. #}
{% if nowo_api_studio_can('workspace.export', workspace) %}
    {% set _items = _items|merge([{label: 'action.export'|trans({}, 'NowoApiStudioBundle'), href: api_studio_path('nowo_api_studio_io_export_openapi_service', {workspaceId: workspace.id, serviceId: service.id})}]) %}
{% endif %}
{% if nowo_api_studio_can('workspace.import', workspace) %}
    {% set _importOpenApi = api_studio_path('nowo_api_studio_io_import_openapi_service', {workspaceId: workspace.id, serviceId: service.id}) %}
    {% set _importPostman = api_studio_path('nowo_api_studio_io_import_postman_service', {workspaceId: workspace.id, serviceId: service.id}) %}
    {% set _items = _items|merge([
        {label: 'import.openapi.service_title'|trans({}, 'NowoApiStudioBundle'), href: _importOpenApi, attr: nowo_ui_remote_form_opener('as-service-dialog', 'import.openapi.service_title'|trans({}, 'NowoApiStudioBundle'), false, _importOpenApi)},
        {label: 'import.postman.service_title'|trans({}, 'NowoApiStudioBundle'), href: _importPostman, attr: nowo_ui_remote_form_opener('as-service-dialog', 'import.postman.service_title'|trans({}, 'NowoApiStudioBundle'), false, _importPostman)},
    ]) %}
{% endif %}
{% set _items = _items|merge([
    {label: 'action.open_service'|trans({}, 'NowoApiStudioBundle'), href: api_studio_path('nowo_api_studio_service_show', {workspaceId: workspace.id, id: service.id})},
    {label: 'action.view_endpoints'|trans({}, 'NowoApiStudioBundle'), href: api_studio_path('nowo_api_studio_endpoint_index', {workspaceId: workspace.id, serviceId: service.id})},
]) %}
{% if nowo_api_studio_can('workspace.edit', workspace) %}
    {% set _items = _items|merge([
        {label: 'action.edit'|trans({}, 'NowoApiStudioBundle'), href: api_studio_path('nowo_api_studio_service_edit', {workspaceId: workspace.id, id: service.id})},
        {label: 'action.delete'|trans({}, 'NowoApiStudioBundle'), href: api_studio_path('nowo_api_studio_service_delete', {workspaceId: workspace.id, id: service.id}) ~ '?redirect=' ~ delete_redirect|url_encode, danger: true, attr: nowo_ui_remote_form_opener('as-service-dialog', 'service.delete_title'|trans({}, 'NowoApiStudioBundle'), false, api_studio_path('nowo_api_studio_service_delete', {workspaceId: workspace.id, id: service.id}) ~ '?redirect=' ~ delete_redirect|url_encode)},
    ]) %}
{% endif %}
{{ include('@NowoUiKitBundle/partials/_kebab.html.twig', {
    label: 'actions.more_options'|trans({}, 'NowoApiStudioBundle'),
    items: _items,
}, false) }}
