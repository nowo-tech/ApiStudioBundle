{#
  API tree (workspaces > services > endpoints > saved requests) from api_studio_nav_tree() (one query). Bundle partial
  meant for overriding (templates/bundles/NowoApiStudioBundle/_sidebar_tree.html.twig).
  Variables: nav_active ({workspace, service, endpoint}: the open branch), bundle.
  The filter is a Symfony Form view rendered without a form element (client-side only: api-studio-shell.js reads
  #as-tree-filter; REQ-TWIG-005). The locale switch (route nowo_api_studio_locale_switch) belongs to the host layout.
#}
{% set bundle = bundle|default(null) %}
{% set active_ws = nav_active.workspace|default(null) %}
{% set active_svc = nav_active.service|default(null) %}
{% set active_ep = nav_active.endpoint|default(null) %}
<aside class="{{ nowo_ui_class('card', bundle) }} as-sidebar" id="as-sidebar"{{ nowo_ui_attrs('card', bundle) }}>
    <div class="as-sidebar-head">
        <h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'sidebar.endpoints'|trans({}, 'NowoApiStudioBundle') }}</h2>
        {% set _tree_filter = api_studio_tree_filter_form() %}
        {% form_theme _tree_filter 'form_div_layout.html.twig' %}
        {{ form_widget(_tree_filter.search) }}
    </div>
    <nav class="as-sidebar-tree" id="as-nav-tree" aria-label="{{ 'sidebar.navigation'|trans({}, 'NowoApiStudioBundle') }}">
        {% for ws in api_studio_nav_tree() %}
            <div class="as-tree-group{% if active_ws == ws.id %} is-open{% endif %}" data-tree-group>
                <div class="as-tree-label{% if active_ws == ws.id %} is-active{% endif %}" data-tree-toggle role="button" tabindex="0">
                    <span class="as-tree-chevron" aria-hidden="true">▶</span>
                    <a href="{{ ws.url }}">{{ ws.name }}</a>
                </div>
                <div class="as-tree-children">
                    {% for svc in ws.services %}
                        <div class="as-tree-svc{% if active_svc == svc.id %} is-active{% endif %}">
                            <span class="as-method as-method-default as-method--compact">{{ svc.protocol|upper }}</span>
                            <a href="{{ svc.url }}">{{ svc.name }}</a>
                        </div>
                        {{ include('@NowoApiStudioBundle/_sidebar_endpoints.html.twig', {svc: svc, active_ep: active_ep}, false) }}
                    {% else %}
                        <div class="as-tree-endpoint as-tree-empty">{{ 'empty.services'|trans({}, 'NowoApiStudioBundle') }}</div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <p class="{{ nowo_ui_class('muted', bundle) }} as-tree-empty">{{ 'empty.workspaces'|trans({}, 'NowoApiStudioBundle') }}</p>
        {% endfor %}
    </nav>
</aside>
