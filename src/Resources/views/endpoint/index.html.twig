{#
  Endpoints of a service (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  ApiStudioPageFactory::endpointIndex(): header section.endpoints / base URL with New endpoint; columns method, name,
  path, saved requests; rows {id, method, name, path, examples, href, edit}; row actions Open / Edit; EmptyState).
  Blocks filled: nowo_ui_styles, nowo_ui_list_row (method badge, the name links to the request console).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'field.method'|trans }}"><span class="as-app"><span class="as-method {{ api_studio_method_class(row.method) }}">{{ row.method }}</span></span></td>
    <td class="{{ _cell }}" data-label="{{ 'field.name'|trans }}" data-required="1"><a href="{{ row.href }}">{{ row.name }}</a></td>
    <td class="{{ _cell }}" data-label="{{ 'field.path'|trans }}" data-nowo-ui-priority="2"><code class="{{ nowo_ui_class('code', page.bundle) }}">{{ row.path }}</code></td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'examples.use_cases'|trans }}" data-nowo-ui-priority="3">{{ row.examples }}</td>
{% endblock %}
