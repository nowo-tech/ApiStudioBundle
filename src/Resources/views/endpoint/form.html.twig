{% extends '@NowoApiStudioBundle/base.html.twig' %}
{% set as_active_workspace = workspace.id %}
{% set as_active_service = service.id %}

{% block title %}{{ title|trans({}, 'NowoApiStudioBundle') }}{% endblock %}
{% block topbar_title %}{{ service.name }} · {{ title|trans({}, 'NowoApiStudioBundle') }}{% endblock %}

{% block body %}
<div class="as-content-inner">
    <div class="as-form-panel">
        {{ form_start(form, {attr: {class: 'as-form'}}) }}
        {% for child in form %}
            {% if child.vars.name != 'translations' %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}

        <fieldset class="as-form-section as-translations-section">
            <legend class="as-form-section-title">{{ 'endpoint.translations'|trans({}, 'NowoApiStudioBundle') }}</legend>
            <p class="as-hint">{{ 'endpoint.doc_tabs_hint'|trans({}, 'NowoApiStudioBundle') }}</p>
            {{ form_errors(form.translations) }}
            {% set _locale_labels = {} %}
            {% for locale in enabledLocales %}
                {% set _locale_labels = _locale_labels|merge({(locale): ('locale.' ~ locale)|trans({}, 'NowoApiStudioBundle')}) %}
            {% endfor %}
            {# FormKit locale tabs (mode entries) through the UiKit locale_tabs partial. #}
            {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', form.translations.vars.locale_tabs|default({})|merge({
                field: form.translations,
                tabs_id: 'endpoint-form-locale',
                active_locale: currentLocale,
                tabs_label: 'endpoint.doc_languages'|trans({}, 'NowoApiStudioBundle'),
                testid: 'endpoint-form-locale-tabs',
                locale_labels: _locale_labels,
            }), with_context: false) }}
        </fieldset>

        <div class="as-form-actions">
            <button type="submit" class="as-btn as-btn-primary">{{ 'action.save'|trans({}, 'NowoApiStudioBundle') }}</button>
            <a href="{{ path('nowo_api_studio_service_show', {workspaceId: workspace.id, id: service.id}) }}" class="as-btn">{{ 'action.cancel'|trans({}, 'NowoApiStudioBundle') }}</a>
        </div>
        {{ form_end(form, {render_rest: false}) }}
    </div>
    {% if endpoint is defined and endpoint.id %}
        {{ include('@NowoApiStudioBundle/_delete_confirm.html.twig', {
            id: 'endpoint-delete-confirm',
            action: path('nowo_api_studio_endpoint_delete', {workspaceId: workspace.id, serviceId: service.id, id: endpoint.id}),
            token: csrf_token('delete' ~ endpoint.id),
        }, with_context: false) }}
    {% endif %}
</div>
{% endblock %}
