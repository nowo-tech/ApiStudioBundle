{#
  Workspaces (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  ApiStudioPageFactory::workspaceIndex(): header page.workspaces with New workspace; columns name, slug; rows
  {id, name, slug, href, edit}; row actions Open / Edit; Pagination (ui.list_page_size); EmptyState).
  Blocks filled: nowo_ui_styles, nowo_ui_list_row (the name links to the workspace, slug in the code slot).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'field.name'|trans }}" data-required="1"><a href="{{ row.href }}">{{ row.name }}</a></td>
    <td class="{{ _cell }}" data-label="{{ 'field.slug'|trans }}" data-nowo-ui-priority="2"><code class="{{ nowo_ui_class('code', page.bundle) }}">{{ row.slug }}</code></td>
{% endblock %}
