{#
  Workspace (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from
  ApiStudioPageFactory::workspaceShow(): header = workspace name / description with New service, New environment,
  Environments, Import / Export, Edit; breadcrumbs; section details (slug, services, environments)).
  Also: workspace (ApiWorkspace: its services feed the collection list).
  Blocks filled: nowo_ui_styles, nowo_ui_scripts, nowo_ui_show_sections (workbench: API tree + details + service
  collections + import / export links), nowo_ui_modals (service export / import / delete dialogs).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_scripts.html.twig') }}
{% endblock %}

{% block nowo_ui_show_sections %}
    {% embed '@NowoApiStudioBundle/_workbench.html.twig' with {bundle: page.bundle, nav_active: {workspace: workspace.id}} %}
        {% block as_workbench_main %}
            {{ block('nowo_ui_show_sections', '@NowoUiKit/page/show.html.twig') }}
            <section class="{{ nowo_ui_class('card', bundle) }}" data-testid="api-studio-service-collections"{{ nowo_ui_attrs('card', bundle) }}>
                <header class="{{ nowo_ui_class('card_header', bundle) }}">
                    <h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'section.services'|trans({}, 'NowoApiStudioBundle') }}</h2>
                    <p class="{{ nowo_ui_class('card_intro', bundle) }}">{{ 'service.collections_hint'|trans({}, 'NowoApiStudioBundle') }}</p>
                </header>
                <div class="{{ nowo_ui_class('card_body', bundle) }}">
                    {{ include('@NowoApiStudioBundle/_service_collection_list.html.twig', {services: workspace.services, workspace: workspace, bundle: bundle}, false) }}
                </div>
            </section>
            {{ include('@NowoApiStudioBundle/import_export/_workspace_panel.html.twig', {workspace: workspace, bundle: bundle}, false) }}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_service_action_modals.html.twig', {bundle: page.bundle}, false) }}
{% endblock %}
