{#
  Service (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from ApiStudioPageFactory::serviceShow():
  header = service name / description with New endpoint, Environments, Edit; breadcrumbs; section details (protocol,
  base URL, auth type, endpoints)). Also: workspace, service, variableCatalog, environments.
  Blocks filled: nowo_ui_styles, nowo_ui_scripts, nowo_ui_show_sections (workbench: API tree + details + endpoints
  with their saved requests + workspace variables + import links), nowo_ui_modals (service dialogs of the menu).
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_scripts.html.twig') }}
{% endblock %}

{% block nowo_ui_show_sections %}
    {% embed '@NowoApiStudioBundle/_workbench.html.twig' with {bundle: page.bundle, nav_active: {workspace: workspace.id, service: service.id}} %}
        {% block as_workbench_main %}
            {{ block('nowo_ui_show_sections', '@NowoUiKit/page/show.html.twig') }}
            <section class="{{ nowo_ui_class('card', bundle) }}" data-testid="api-studio-service-endpoints"{{ nowo_ui_attrs('card', bundle) }}>
                <header class="{{ nowo_ui_class('card_header', bundle) }} as-card-head">
                    <div>
                        <h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'section.endpoints'|trans({}, 'NowoApiStudioBundle') }}</h2>
                        <p class="{{ nowo_ui_class('card_intro', bundle) }}">{{ 'examples.list_hint'|trans({}, 'NowoApiStudioBundle') }}</p>
                    </div>
                    {{ include('@NowoApiStudioBundle/_service_kebab_menu.html.twig', {service: service, workspace: workspace, bundle: bundle}, false) }}
                </header>
                <div class="{{ nowo_ui_class('card_body', bundle) }}">
                    {{ include('@NowoApiStudioBundle/_endpoint_expandable_list.html.twig', {endpoints: service.endpoints, service: service, workspace: workspace}, false) }}
                </div>
            </section>
            <section class="{{ nowo_ui_class('card', bundle) }}" data-testid="api-studio-service-variables"{{ nowo_ui_attrs('card', bundle) }}>
                <header class="{{ nowo_ui_class('card_header', bundle) }}">
                    <h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'variables.workspace_title'|trans({}, 'NowoApiStudioBundle') }}</h2>
                    <p class="{{ nowo_ui_class('card_intro', bundle) }}">{{ 'variables.service_scope'|trans({}, 'NowoApiStudioBundle') }}</p>
                </header>
                <div class="{{ nowo_ui_class('card_body', bundle) }}">
                    {{ include('@NowoApiStudioBundle/_variable_catalog.html.twig', {variableCatalog: variableCatalog, environments: environments, workspace: workspace, bundle: bundle}, false) }}
                </div>
            </section>
            <section class="{{ nowo_ui_class('card', bundle) }}" data-testid="api-studio-service-import"{{ nowo_ui_attrs('card', bundle) }}>
                <header class="{{ nowo_ui_class('card_header', bundle) }}"><h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'import_export.import_title'|trans({}, 'NowoApiStudioBundle') }}</h2></header>
                <div class="{{ nowo_ui_class('card_body', bundle) }} {{ nowo_ui_class('toolbar', bundle) }}">
                    <a class="{{ nowo_ui_class('btn_secondary', bundle) }}" href="{{ path('nowo_api_studio_io_import_openapi_service', {workspaceId: workspace.id, serviceId: service.id}) }}">{{ 'import.openapi.service_short'|trans({}, 'NowoApiStudioBundle') }}</a>
                    <a class="{{ nowo_ui_class('btn_secondary', bundle) }}" href="{{ path('nowo_api_studio_io_import_postman_service', {workspaceId: workspace.id, serviceId: service.id}) }}">{{ 'import.postman.service_short'|trans({}, 'NowoApiStudioBundle') }}</a>
                </div>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_service_action_modals.html.twig', {bundle: page.bundle}, false) }}
{% endblock %}
