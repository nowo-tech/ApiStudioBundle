{#
  Environments of a workspace (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  ApiStudioPageFactory::environmentIndex(): header section.environments with New environment; columns name,
  variables; rows {id, name, default, variables, href, edit}; row actions Open / Edit; EmptyState).
  Blocks filled: nowo_ui_styles, nowo_ui_list_row (name + default badge).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'field.name'|trans }}" data-required="1">
        <a href="{{ row.href }}">{{ row.name }}</a>
        {% if row.default %}<span class="{{ nowo_ui_class('badge_info', page.bundle) }}">{{ 'env.default'|trans }}</span>{% endif %}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'field.variables'|trans }}">{{ row.variables }}</td>
{% endblock %}
