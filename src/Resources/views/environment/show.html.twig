{#
  Environment (REQ-UI-003): UiKit show scaffold. Variable: page (View\ShowPage from
  ApiStudioPageFactory::environmentShow(): header = environment name / slug with Import variables and Edit;
  breadcrumbs; section export (JSON, YAML, .env links)). Also: environment (ApiEnvironment: its variables).
  Blocks filled: nowo_ui_styles, nowo_ui_show_sections (variables table, then the export section); secret values are
  masked.
#}
{% extends '@NowoUiKit/page/show.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_show_sections %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('card', _b) }}" data-testid="api-studio-environment-variables"{{ nowo_ui_attrs('card', _b) }}>
        <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'variables.section_title'|trans }}</h2></header>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            <div class="{{ nowo_ui_class('table_wrap', _b) }}">
                <table class="{{ nowo_ui_class('table', _b) }}">
                    <thead class="{{ nowo_ui_class('table_head', _b) }}">
                        <tr>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'variables.syntax'|trans }}</th>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'field.value'|trans }}</th>
                            <th scope="col" class="{{ nowo_ui_class('table_head_cell', _b) }}">{{ 'field.secret'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for variable in environment.variables %}
                        <tr class="{{ nowo_ui_class('table_row', _b) }}">
                            <td class="{{ nowo_ui_class('table_cell', _b) }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ api_studio_var(variable.variableKey) }}</code></td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }}">{% if variable.secret %}••••••{% else %}{{ variable.value }}{% endif %}</td>
                            <td class="{{ nowo_ui_class('table_cell', _b) }}">{{ (variable.secret ? 'common.yes' : 'common.no')|trans }}</td>
                        </tr>
                    {% else %}
                        <tr class="{{ nowo_ui_class('table_row', _b) }}"><td colspan="3" class="{{ nowo_ui_class('table_cell_muted', _b) }}">{{ 'empty.variables'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    {{ parent() }}
{% endblock %}
