{#
  Dashboard (REQ-UI-003): UiKit dashboard scaffold. Variable: page (View\DashboardPage from
  ApiStudioPageFactory::dashboard(): header page.dashboard / dashboard.subtitle with New workspace; KPI tiles
  workspaces (link to the list), services, endpoints).
  Also: workspaces (first ui.list_page_size workspaces), workspaceCount.
  Blocks filled: nowo_ui_styles, nowo_ui_scripts, nowo_ui_dashboard_cards (workbench: API tree + projects card).
#}
{% extends '@NowoUiKit/page/dashboard.html.twig' %}
{% trans_default_domain 'NowoApiStudioBundle' %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_styles.html.twig') }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoApiStudioBundle/_scripts.html.twig') }}
{% endblock %}

{% block nowo_ui_dashboard_cards %}
    {% set _b = page.bundle %}
    {% embed '@NowoApiStudioBundle/_workbench.html.twig' with {bundle: _b} %}
        {% block as_workbench_main %}
            <section class="{{ nowo_ui_class('card', bundle) }}" data-testid="api-studio-projects"{{ nowo_ui_attrs('card', bundle) }}>
                <header class="{{ nowo_ui_class('card_header', bundle) }}">
                    <h2 class="{{ nowo_ui_class('card_title', bundle) }}">{{ 'dashboard.projects'|trans({}, 'NowoApiStudioBundle') }}</h2>
                </header>
                <div class="{{ nowo_ui_class('card_body', bundle) }}">
                    {% if workspaces is empty %}
                        {{ include(nowo_ui_partial('empty', bundle), {message: 'empty.workspaces'|trans({}, 'NowoApiStudioBundle'), bundle: bundle}, false) }}
                    {% else %}
                        <div class="as-project-grid">
                            {% for workspace in workspaces %}
                                <a href="{{ path('nowo_api_studio_workspace_show', {id: workspace.id}) }}" class="as-project-card as-project-card--{{ loop.index0 % 5 }}">
                                    <span class="as-project-icon" aria-hidden="true">⬡</span>
                                    <h3>{{ workspace.name }}</h3>
                                    <p>{{ workspace.slug }} · {{ workspace.services|length }} {{ 'section.services'|trans({}, 'NowoApiStudioBundle')|lower }}</p>
                                </a>
                            {% endfor %}
                        </div>
                        {% if workspaceCount > workspaces|length %}
                            <p><a href="{{ path('nowo_api_studio_workspace_index') }}">{{ 'action.view_all'|trans({}, 'NowoApiStudioBundle') }}</a></p>
                        {% endif %}
                    {% endif %}
                </div>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
